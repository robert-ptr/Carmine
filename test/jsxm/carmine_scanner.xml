<?xml version="1.0" encoding="UTF-8"?>
<SXM name="CarmineScanner">
	<states>
		<state name="START" />
		<state name="IN_IDENT" />
		<state name="IN_DECIMAL" />
		<state name="SAW_ZERO" />
		<state name="IN_BIN_PREFIX" />
		<state name="IN_BIN" />
		<state name="IN_HEX_PREFIX" />
		<state name="IN_HEX" />
		<state name="SAW_SLASH" />
		<state name="IN_COMMENT" />
		<state name="SAW_MINUS" />
		<state name="SAW_STAR" />
		<state name="SAW_EQUAL" />
		<state name="SAW_LESS" />
		<state name="SAW_GREATER" />
		<state name="SAW_BANG" />
		</states>
	
	<initialState state="START" />
	
	<memory>
		<declaration>
			String fullCode;
			String pendingToken;
		</declaration>
		<initial>
			fullCode = "";
			pendingToken = "";
		</initial>
	</memory>
	
	<inputs>
		<input name="alpha"><arg name="c" type="xs:string" /></input>
		<input name="digit"><arg name="c" type="xs:string" /></input>
		<input name="digit0" />
		<input name="hexAlpha"><arg name="c" type="xs:string" /></input>
		<input name="binDigit"><arg name="c" type="xs:string" /></input>
		<input name="space"><arg name="c" type="xs:string" /></input>
		<input name="newline" />
		<input name="slash" />
		<input name="minus" />
		<input name="star" />
		<input name="equal" />
		<input name="less" />
		<input name="greater" />
		<input name="bang" />
		<input name="b_char" />
		<input name="X_char" />
		<input name="dot" />
		<input name="symbol"><arg name="c" type="xs:string" /></input>
		<input name="EOF" />
	</inputs>
	
	<outputs>
		<output name="scanOut"><result name="tokens" type="xs:string" /></output>
	</outputs>
	
	<functions>
		
		

		
		<function name="toINIdent" input="alpha" output="scanOut">
			<effect> fullCode += alpha.get_c(); scanOut.tokens = ""; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="toINIdentHex" input="hexAlpha" output="scanOut">
			<effect> fullCode += hexAlpha.get_c(); scanOut.tokens = ""; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="toINIdentB" input="b_char" output="scanOut">
			<effect> fullCode += "b"; scanOut.tokens = ""; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="toINIdentX" input="X_char" output="scanOut">
			<effect> fullCode += "X"; scanOut.tokens = ""; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="toINDecimal" input="digit" output="scanOut">
			<effect> fullCode += digit.get_c(); scanOut.tokens = ""; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="toINDecimalBin" input="binDigit" output="scanOut">
			<effect> fullCode += binDigit.get_c(); scanOut.tokens = ""; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="toSAWZero" input="digit0" output="scanOut">
			<effect> fullCode += "0"; scanOut.tokens = ""; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="toStartSpace" input="space" output="scanOut">
			<effect> fullCode += space.get_c(); scanOut.tokens = ""; pendingToken = ""; </effect>
		</function>
		<function name="toStartNewline" input="newline" output="scanOut">
			<effect> fullCode += "\n"; scanOut.tokens = ""; pendingToken = ""; </effect>
		</function>
		<function name="toSAWSlash" input="slash" output="scanOut">
			<effect> fullCode += "/"; scanOut.tokens = ""; pendingToken = "DIV"; </effect>
		</function>
		<function name="toSAWMinus" input="minus" output="scanOut">
			<effect> fullCode += "-"; scanOut.tokens = ""; pendingToken = "MINUS"; </effect>
		</function>
		<function name="toSAWStar" input="star" output="scanOut">
			<effect> fullCode += "*"; scanOut.tokens = ""; pendingToken = "MUL"; </effect>
		</function>
		<function name="toSAWEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = ""; pendingToken = "ASSIGN"; </effect>
		</function>
		<function name="toSAWLess" input="less" output="scanOut">
			<effect> fullCode += "&lt;"; scanOut.tokens = ""; pendingToken = "LESS"; </effect>
		</function>
		<function name="toSAWGreater" input="greater" output="scanOut">
			<effect> fullCode += "&gt;"; scanOut.tokens = ""; pendingToken = "GREATER"; </effect>
		</function>
		<function name="toSAWBang" input="bang" output="scanOut">
			<effect> fullCode += "!"; scanOut.tokens = ""; pendingToken = "ERR"; </effect>
		</function>
		<function name="toStartDot" input="dot" output="scanOut">
			<effect> fullCode += "."; scanOut.tokens = "DOT"; pendingToken = ""; </effect>
		</function>
		<function name="toStartSymbol" input="symbol" output="scanOut">
			<effect>
				fullCode += symbol.get_c();
				String s = symbol.get_c();
				String tk = "";
				if (s.equals("(")) tk = "LPAREN";
				else if (s.equals(")")) tk = "RPAREN";
				else if (s.equals("[")) tk = "LBRACKET";
				else if (s.equals("]")) tk = "RBRACKET";
				else if (s.equals("{")) tk = "LBRACE";
				else if (s.equals("}")) tk = "RBRACE";
				else if (s.equals(",")) tk = "COMMA";
				else if (s.equals(";")) tk = "SEMICOLON";
				else if (s.equals("&amp;")) tk = "AND";
				else if (s.equals("|")) tk = "OR";
				else if (s.equals("+")) tk = "PLUS";
				else if (s.equals("%")) tk = "MOD";
				scanOut.tokens = tk;
				pendingToken = "";
			</effect>
		</function>
		<function name="toFinalEOF" input="EOF" output="scanOut">
			<effect> scanOut.tokens = ""; pendingToken = ""; </effect>
		</function>

		
		<function name="emitToINIdent" input="alpha" output="scanOut">
			<effect> fullCode += alpha.get_c(); scanOut.tokens = pendingToken; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="emitToINIdentHex" input="hexAlpha" output="scanOut">
			<effect> fullCode += hexAlpha.get_c(); scanOut.tokens = pendingToken; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="emitToINIdentB" input="b_char" output="scanOut">
			<effect> fullCode += "b"; scanOut.tokens = pendingToken; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="emitToINIdentX" input="X_char" output="scanOut">
			<effect> fullCode += "X"; scanOut.tokens = pendingToken; pendingToken = "IDENTIFIER"; </effect>
		</function>
		<function name="emitToINDecimal" input="digit" output="scanOut">
			<effect> fullCode += digit.get_c(); scanOut.tokens = pendingToken; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="emitToINDecimalBin" input="binDigit" output="scanOut">
			<effect> fullCode += binDigit.get_c(); scanOut.tokens = pendingToken; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="emitToSAWZero" input="digit0" output="scanOut">
			<effect> fullCode += "0"; scanOut.tokens = pendingToken; pendingToken = "DECIMAL"; </effect>
		</function>
		<function name="emitToStartSpace" input="space" output="scanOut">
			<effect> fullCode += space.get_c(); scanOut.tokens = pendingToken; pendingToken = ""; </effect>
		</function>
		<function name="emitToStartNewline" input="newline" output="scanOut">
			<effect> fullCode += "\n"; scanOut.tokens = pendingToken; pendingToken = ""; </effect>
		</function>
		<function name="emitToSAWSlash" input="slash" output="scanOut">
			<effect> fullCode += "/"; scanOut.tokens = pendingToken; pendingToken = "DIV"; </effect>
		</function>
		<function name="emitToSAWMinus" input="minus" output="scanOut">
			<effect> fullCode += "-"; scanOut.tokens = pendingToken; pendingToken = "MINUS"; </effect>
		</function>
		<function name="emitToSAWStar" input="star" output="scanOut">
			<effect> fullCode += "*"; scanOut.tokens = pendingToken; pendingToken = "MUL"; </effect>
		</function>
		<function name="emitToSAWEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = pendingToken; pendingToken = "ASSIGN"; </effect>
		</function>
		<function name="emitToSAWLess" input="less" output="scanOut">
			<effect> fullCode += "&lt;"; scanOut.tokens = pendingToken; pendingToken = "LESS"; </effect>
		</function>
		<function name="emitToSAWGreater" input="greater" output="scanOut">
			<effect> fullCode += "&gt;"; scanOut.tokens = pendingToken; pendingToken = "GREATER"; </effect>
		</function>
		<function name="emitToSAWBang" input="bang" output="scanOut">
			<effect> fullCode += "!"; scanOut.tokens = pendingToken; pendingToken = "ERR"; </effect>
		</function>
		<function name="emitToStartDot" input="dot" output="scanOut">
			<effect> fullCode += "."; scanOut.tokens = (pendingToken.equals("") ? "" : pendingToken + " ") + "DOT"; pendingToken = ""; </effect>
		</function>
		<function name="emitToStartSymbol" input="symbol" output="scanOut">
			<effect>
				fullCode += symbol.get_c();
				String s = symbol.get_c();
				String tk = "";
				if (s.equals("(")) tk = "LPAREN";
				else if (s.equals(")")) tk = "RPAREN";
				else if (s.equals("[")) tk = "LBRACKET";
				else if (s.equals("]")) tk = "RBRACKET";
				else if (s.equals("{")) tk = "LBRACE";
				else if (s.equals("}")) tk = "RBRACE";
				else if (s.equals(",")) tk = "COMMA";
				else if (s.equals(";")) tk = "SEMICOLON";
				else if (s.equals("&amp;")) tk = "AND";
				else if (s.equals("|")) tk = "OR";
				else if (s.equals("+")) tk = "PLUS";
				else if (s.equals("%")) tk = "MOD";
				scanOut.tokens = (pendingToken.equals("") ? "" : pendingToken + " ") + tk;
				pendingToken = "";
			</effect>
		</function>
		<function name="emitToFinalEOF" input="EOF" output="scanOut">
			<effect> scanOut.tokens = pendingToken; pendingToken = ""; </effect>
		</function>

		
		<function name="minusToArrow" input="greater" output="scanOut">
			<effect> fullCode += "&gt;"; scanOut.tokens = "ARROW"; pendingToken = ""; </effect>
		</function>
		<function name="starToExp" input="star" output="scanOut">
			<effect> fullCode += "*"; scanOut.tokens = "EXP"; pendingToken = ""; </effect>
		</function>
		<function name="equalEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = "EQUAL"; pendingToken = ""; </effect>
		</function>
		<function name="lessEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = "LESS_EQUAL"; pendingToken = ""; </effect>
		</function>
		<function name="greaterEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = "GREATER_EQUAL"; pendingToken = ""; </effect>
		</function>
		<function name="bangEqual" input="equal" output="scanOut">
			<effect> fullCode += "="; scanOut.tokens = "NOTEQUAL"; pendingToken = ""; </effect>
		</function>
		<function name="slashToComment" input="slash" output="scanOut">
			<effect> fullCode += "/"; scanOut.tokens = ""; pendingToken = ""; </effect>
		</function>

		
		<function name="zeroToBinPrefix" input="b_char" output="scanOut">
			<effect> fullCode += "b"; scanOut.tokens = ""; pendingToken = "ERR"; </effect>
		</function>
		<function name="zeroToHexPrefix" input="X_char" output="scanOut">
			<effect> fullCode += "X"; scanOut.tokens = ""; pendingToken = "ERR"; </effect>
		</function>
		<function name="toINBin" input="binDigit" output="scanOut">
			<effect> fullCode += binDigit.get_c(); scanOut.tokens = ""; pendingToken = "BINARY"; </effect>
		</function>
		<function name="toINHex" input="digit" output="scanOut">
			<effect> fullCode += digit.get_c(); scanOut.tokens = ""; pendingToken = "HEXADECIMAL"; </effect>
		</function>
		<function name="toINHexAlpha" input="hexAlpha" output="scanOut">
			<effect> fullCode += hexAlpha.get_c(); scanOut.tokens = ""; pendingToken = "HEXADECIMAL"; </effect>
		</function>
		<function name="toINHexB" input="b_char" output="scanOut">
			<effect> fullCode += "b"; scanOut.tokens = ""; pendingToken = "HEXADECIMAL"; </effect>
		</function>

		
		<function name="toStayDot" input="dot" output="scanOut">
			<effect> fullCode += "."; scanOut.tokens = ""; </effect>
		</function>
		<function name="toStaySymbol" input="symbol" output="scanOut">
			<effect> fullCode += symbol.get_c(); scanOut.tokens = ""; </effect>
		</function>
	</functions>
	
